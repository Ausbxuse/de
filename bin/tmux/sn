#!/usr/bin/env bash

set -euo pipefail

folders=(~/src/public ~/src/school ~/Research ~/src/dev)
codex_cmd="nix run github:sadjow/codex-cli-nix"

dir_list=$(fd . --type d --exact-depth 1 "${folders[@]}" 2>/dev/null || true)
session_list=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | sed 's/^/session:/' || true)

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(printf "%s\n%s\n" "$session_list" "$dir_list" | fzf --reverse --prompt="session or dir > ")
fi

if [[ -z ${selected:-} ]]; then
  exit 0
fi

if [[ $selected == session:* ]]; then
  session_name="${selected#session:}"
  if [[ -z ${TMUX:-} ]]; then
    tmux attach -t "=${session_name}"
  else
    tmux switch-client -t "=${session_name}"
  fi
  exit 0
fi

selected_name=$(basename "$selected" | tr '.:' '__')

create_project_session() {
  tmux new-session -d -s "$selected_name" -n "$selected_name" -c "$selected" "$codex_cmd"
  tmux split-window -t "=${selected_name}:=${selected_name}" -h -c "$selected"
  tmux select-pane -t "=${selected_name}:=${selected_name}.0"
  tmux select-layout -t "=${selected_name}:=${selected_name}" main-vertical
}

select_project_window() {
  tmux select-window -t "=${selected_name}:=${selected_name}" 2>/dev/null || true
}

if ! tmux has-session -t "=${selected_name}" 2>/dev/null; then
  create_project_session
fi

if [[ -z ${TMUX:-} ]]; then
  select_project_window
  tmux attach -t "=${selected_name}"
else
  tmux switch-client -t "=${selected_name}"
  select_project_window
fi

if command -v gnome-extensions >/dev/null 2>&1; then
  gnome-extensions disable ubuntu-dock@ubuntu.com || true
fi
