#!/usr/bin/env bash

folders=(~/src/public ~/src/school ~/Research)

dir_list=$(fd . --type d --exact-depth 1 "${folders[@]}" 2>/dev/null)
session_list=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | sed 's/^/session:/')

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(printf "%s\n%s\n" "$session_list" "$dir_list" | fzf --reverse --prompt="session or dir > ")
fi

if [[ -z $selected ]]; then
  exit 0
fi

if [[ $selected == session:* ]]; then
  session_name="${selected#session:}"
  if [[ -z $TMUX ]]; then
    tmux attach -t "$session_name"
  else
    tmux switch-client -t "$session_name"
  fi
  exit 0
fi


selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
  tmux new-session -s "$selected_name" -c "$selected"
  exit 0
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
  tmux new-session -ds "$selected_name" -n "shell" -c "$selected"
  # tmux send-keys -t "$selected_name:1" "nvim" C-m
  # tmux split-window -t "$selected_name:1" -h -c "$selected"
  # tmux select-pane -t "$selected_name:1.0"
fi

tmux switch-client -t "$selected_name"
tmux select-window -t "$selected_name:1"

gnome-extensions disable ubuntu-dock@ubuntu.com
