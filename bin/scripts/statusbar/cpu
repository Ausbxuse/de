#!/usr/bin/env bash

get_theme() {
    local theme_file scheme
    theme_file="${XDG_CACHE_HOME:-$HOME/.cache}/tmux/theme"
    if [ -n "${TMUX_COLOR_SCHEME:-}" ]; then
        printf "%s" "$TMUX_COLOR_SCHEME"
        return
    fi
    if [ -f "$theme_file" ]; then
        tr -d ' \t\r\n' < "$theme_file"
        return
    fi
    if command -v gsettings >/dev/null 2>&1; then
        scheme=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | tr -d "'")
        case "$scheme" in
            *dark*) printf "dark"; return ;;
            *light*) printf "light"; return ;;
        esac
    fi
    printf "dark"
}

pick_color() {
    local temp="$1"
    if [ "$temp" -le 60 ]; then
        printf "%s" "$ok"
    elif [ "$temp" -le 84 ]; then
        printf "%s" "$warn"
    elif [ "$temp" -le 95 ]; then
        printf "%s" "$hot"
    else
        printf "%s" "$crit"
    fi
}

extract_temp() {
    local pattern="$1" field="$2"
    sensors | awk -v pat="$pattern" -v fld="$field" '
        $0 ~ pat {
            v = $fld
            if (match(v, /[0-9]+/)) {
                print substr(v, RSTART, RLENGTH)
                exit
            }
        }
    '
}

theme=$(get_theme)
if [ "$theme" = "light" ]; then
    ok="#40a02b"
    warn="#df8e1d"
    hot="#fe640b"
    crit="#d20f39"
else
    ok="#9ece6a"
    warn="#f4bf75"
    hot="#f69c5e"
    crit="#ff2640"
fi

cpu_temp=$(extract_temp "Core 0" 3)
gpu_temp=$(extract_temp "GPU" 2)

if [[ "$cpu_temp" =~ ^[0-9]+$ ]]; then
    printf "#[fg=%s]%3s°C" "$(pick_color "$cpu_temp")" "$cpu_temp"
else
    printf "#[fg=%s] N/A" "$crit"
fi

if [[ "$gpu_temp" =~ ^[0-9]+$ ]]; then
    printf "#[fg=%s]%3s°C" "$(pick_color "$gpu_temp")" "$gpu_temp"
fi
