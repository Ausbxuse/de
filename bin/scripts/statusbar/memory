#!/usr/bin/env bash
get_theme() {
    local theme_file scheme
    theme_file="${XDG_CACHE_HOME:-$HOME/.cache}/tmux/theme"
    if [ -n "${TMUX_COLOR_SCHEME:-}" ]; then
        printf "%s" "$TMUX_COLOR_SCHEME"
        return
    fi
    if [ -f "$theme_file" ]; then
        tr -d ' \t\r\n' < "$theme_file"
        return
    fi
    if command -v gsettings >/dev/null 2>&1; then
        scheme=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | tr -d "'")
        case "$scheme" in
            *dark*) printf "dark"; return ;;
            *light*) printf "light"; return ;;
        esac
    fi
    printf "dark"
}

# status=$(free --mebi | sed -n '2{p;q}' | awk '{printf ("%2.0f/%2.0fG\n", ( $3 / 1024), ($2 / 1024))}')
read total used <<<$(free --mebi | awk '/Mem:/ {print $2, $3}')

# choose unit
if (( total >= 1048576 )); then
    unit="T"
    div=1048576
else
    unit="G"
    div=1024
fi

status=$(awk -v u="$used" -v t="$total" -v d="$div" -v unit="$unit" \
    'BEGIN {printf "%.1f/%.1f%s\n", u/d, t/d, unit}')

# case $percentage in
# 	[0-9]) echo -e "\x0f▁" ;;
# 	1[0-9]) echo -e "\x0f▂" ;;
# 	2[0-9]) echo -e "\x0f▃" ;;
# 	3[0-9]) echo -e "\x0f▄" ;;
# 	4[0-9]) echo -e "\x0f▅" ;;
# 	5[0-9]) echo -e "\x0f▆" ;;
# 	6[0-9]) echo -e "\x0f▇" ;;
# 	7[0-9]|8[0-9]|9[0-9]|10[0-9]) echo -e "\x0f█" ;;
# esac
theme=$(get_theme)
if [ "$theme" = "light" ]; then
    color="#1e66f5"
else
    color="#89ddff"
fi
echo "#[fg=$color,bg=default,bold]#[nobold]#[fg=$color]${status}"
